---
/**
 * estudiante/cursos/[courseId]/index.astro — Contenido del Curso (Estudiante)
 * ─────────────────────────────────────────────────────────────────────────
 * Vista del estudiante para ver el contenido semanal del curso.
 * Es de solo lectura (sin permisos de edición).
 */
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { Icon } from 'astro-icon/components';
import { APP_ROUTES } from '../../../../core/config/paths';
import { getCourseById, getCourseWeeksFull, getCourseStats } from '../../../../core/services/api';
import type { ContentWeek, ContentItem } from '../../../../core/types/api.types';

export const prerender = false;

const { courseId } = Astro.params;
const token = Astro.cookies.get('ka_session')?.value ?? '';

if (!courseId) {
  return Astro.redirect('/estudiante/cursos');
}

let courseApi;
let courseStatsApi;
try {
  courseApi = await getCourseById(token, courseId);
  courseStatsApi = await getCourseStats(token, courseId).catch(() => ({ studentCount: 0, averageProgress: 0 }));
} catch (error: any) {
  if (error?.statusCode === 401) return Astro.redirect('/logout');
  return Astro.redirect('/estudiante/cursos');
}

const course = {
  id:              courseApi.id,
  title:           courseApi.title,
  subtitle:        courseApi.subtitle || '',
  code:            courseApi.code,
  status:          courseApi.status.toUpperCase(),
  studentCount:    courseStatsApi.studentCount,
  averageProgress: courseStatsApi.averageProgress,
  pendingTasks:    0, // Falta endpoint para esto
  bannerGradient:  courseApi.bannerGradient || 'from-[#00607A] via-[#008BA8] to-[#00B8D4]',
};

const courseTabs = [
  { label: 'Contenido', icon: 'lucide:layout-list',     href: APP_ROUTES.courseDetail(course.id),          active: true  },
  { label: 'Calendario',icon: 'lucide:calendar',        href: APP_ROUTES.courseCalendar(course.id),        active: false },
  { label: 'Compañeros',icon: 'lucide:users',           href: APP_ROUTES.courseStudents(course.id),        active: false },
  { label: 'Anuncios',  icon: 'lucide:megaphone',       href: APP_ROUTES.courseAnnouncements(course.id),   active: false },
];

const weeksApi = await getCourseWeeksFull(token, courseId).catch(() => []);
const courseWeeks = weeksApi.map((w: ContentWeek & { items?: ContentItem[] }) => {
  const itemsApi = w.items || [];
  return {
    id: w.id,
    weekNumber: w.weekNumber,
    title: w.title,
    isExpanded: true,
    publishedItems: itemsApi.filter((i: ContentItem) => i.isPublished).length, // En backend los estudiantes solo reciben isPublished=true
    totalItems: itemsApi.length,
    items: itemsApi.map((i: ContentItem) => ({
      id: i.id,
      type: i.type,
      kind: ['tarea', 'quiz', 'evaluacion'].includes(i.type) ? 'actividad' : 'material',
      title: i.title,
      meta: i.description || (i.type === 'video' ? 'Video' : 'Recurso'),
      isVisible: i.isVisible,
      dueDate: undefined,
      maxScore: undefined
    }))
  };
});

const resourceTypeIconMap: Record<string, string> = {
  video:      'lucide:video',
  archivo:    'lucide:file-text',
  tarea:      'lucide:clipboard-list',
  evaluacion: 'lucide:star',
  quiz:       'lucide:help-circle',
  enlace:     'lucide:link',
  pdf:        'lucide:file-text',
  audio:      'lucide:headphones',
  text:       'lucide:file-text',
};

const kindColor = (item: { kind: string }) =>
  item.kind === 'actividad'
    ? 'bg-warning-soft text-warning-dark'
    : 'bg-brand-soft text-brand-dark';
---

<DashboardLayout
  pageTitle={`${course.title} — Contenido`}
  breadcrumb="Detalle del Curso"
  activeNav="cursos"
>

  <div class="-mx-6 lg:-mx-8 -mt-6 lg:-mt-8 flex flex-col" data-course-id={courseId}>

    <!-- ░░ BANNER HERO ░░ -->
    <div class={`relative w-full bg-gradient-to-r ${course.bannerGradient} overflow-hidden`}>
      <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-white/5 blur-3xl"></div>
        <div class="absolute right-32 bottom-0 w-56 h-56 rounded-full bg-white/5 blur-2xl"></div>
        <div class="absolute left-1/3 top-1/2 -translate-y-1/2 w-96 h-24 bg-white/[0.04] blur-2xl rotate-12"></div>
      </div>

      <div class="relative z-10 px-8 lg:px-12 pt-8 pb-6">
        <p class="text-white/60 text-xs font-semibold tracking-widest uppercase mb-2">{course.code}</p>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-1 drop-shadow-sm">
              {course.title}
            </h1>
            <p class="text-white/70 text-sm font-medium">{course.subtitle}</p>
          </div>
          <div class="flex items-center gap-3 self-start sm:self-end shrink-0">
            <span class="border border-white/40 text-white text-xs font-extrabold px-4 py-1.5 rounded-full tracking-widest">
              {course.status}
            </span>
          </div>
        </div>

        <!-- Métricas rápidas del curso en el banner -->
        <div class="mt-5 flex items-center gap-6 flex-wrap">
          <span class="flex items-center gap-2 text-white/80 text-xs font-semibold">
            <Icon name="lucide:user" class="w-4 h-4" aria-hidden="true" />
            Profesor: {courseApi.teacher ? `${courseApi.teacher.firstName} ${courseApi.teacher.lastName}` : 'Por asignar'}
          </span>
          <span class="flex items-center gap-2 text-white/80 text-xs font-semibold">
            <Icon name="lucide:trending-up" class="w-4 h-4" aria-hidden="true" />
            {course.averageProgress}% tu progreso
          </span>
          {course.pendingTasks > 0 && (
            <span class="flex items-center gap-2 text-warning-soft text-xs font-bold">
              <Icon name="lucide:inbox" class="w-4 h-4" aria-hidden="true" />
              {course.pendingTasks} tareas pendientes
            </span>
          )}
        </div>
      </div>

      <!-- Tabs de navegación -->
      <nav aria-label="Secciones del curso" class="relative z-10 border-t border-white/10">
        <div class="flex items-center overflow-x-auto px-6 lg:px-12">
          {courseTabs.map(tab => (
            <a
              href={tab.href}
              role="tab"
              aria-selected={tab.active}
              class={[
                'flex items-center gap-2 px-4 py-4 text-sm font-semibold whitespace-nowrap border-b-[3px] transition-all shrink-0',
                tab.active
                  ? 'border-white text-white'
                  : 'border-transparent text-white/60 hover:text-white/90 hover:border-white/30',
              ].join(' ')}
            >
              <Icon name={tab.icon} class="w-4 h-4" aria-hidden="true" />
              {tab.label}
            </a>
          ))}
        </div>
      </nav>
    </div>

    <!-- ░░ CUERPO PRINCIPAL ░░ -->
    <div class="flex-1 bg-page px-6 lg:px-8 py-8">
      <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8 items-start">

        <!-- Columna Izquierda: Semanas / Accordion -->
        <section aria-labelledby="content-manager-heading">
          <div class="flex items-center justify-between mb-6">
            <h2 id="content-manager-heading" class="text-xl font-extrabold text-heading">
              Contenido del curso
            </h2>
          </div>

          <div class="flex flex-col gap-3" id="weeks-accordion">
            {courseWeeks.length === 0 ? (
              <div class="bg-card rounded-2xl border border-edge p-8 text-center">
                <Icon name="lucide:inbox" class="w-8 h-8 text-subtle mx-auto mb-3" aria-hidden="true" />
                <p class="text-subtle font-medium">No hay contenido publicado en este curso todavía.</p>
              </div>
            ) : courseWeeks.map((week) => (
              <article
                class="bg-card rounded-2xl border border-edge overflow-hidden hover:shadow-sm transition-shadow"
                data-week-id={week.id}
              >
                <!-- Cabecera de la semana -->
                <div class="flex items-center gap-4 p-5 cursor-pointer group week-toggle">
                  <div class="w-9 h-9 rounded-xl bg-brand-soft flex items-center justify-center shrink-0" aria-hidden="true">
                    <span class="text-xs font-extrabold text-brand-dark">W{week.weekNumber}</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-heading">{week.title}</h3>
                    <div class="flex items-center gap-3 mt-2">
                      <div class="flex-1 max-w-[160px] h-1 bg-neutral-subtle rounded-full overflow-hidden">
                        <div
                          class="h-full rounded-full bg-brand-dark"
                          style={`width: ${week.totalItems > 0 ? 100 : 0}%`}
                        ></div>
                      </div>
                      <span class="text-xs font-semibold text-subtle shrink-0">
                        {week.totalItems} elementos
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <Icon
                      name="lucide:chevron-down"
                      class="w-5 h-5 text-subtle group-hover:text-heading transition-all duration-200 week-chevron"
                      style={week.isExpanded ? 'transform: rotate(180deg)' : 'transform: rotate(0deg)'}
                      aria-hidden="true"
                    />
                  </div>
                </div>

                <!-- Items de la semana (expandible) -->
                <div class={`border-t border-edge-soft ${week.isExpanded ? '' : 'hidden'} week-items`}>
                  {week.items.length === 0 ? (
                    <div class="px-5 py-6 text-center">
                      <p class="text-sm text-subtle italic">Sin elementos en esta semana.</p>
                    </div>
                  ) : (
                    <ul class="divide-y divide-edge-soft">
                      {week.items.map((item) => (
                        <li class="flex items-center gap-3 px-5 py-3 hover:bg-neutral-bg/50 transition-colors group/item" data-item-id={item.id}>
                          <!-- Ícono de tipo -->
                          <div class={`w-8 h-8 rounded-lg flex items-center justify-center shrink-0 ${kindColor(item)}`}>
                            <Icon
                              name={resourceTypeIconMap[item.type] ?? 'lucide:file'}
                              class="w-4 h-4"
                              aria-hidden="true"
                            />
                          </div>

                          <!-- Info -->
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                              <p class="text-sm font-semibold truncate text-heading">
                                {item.title}
                              </p>
                              {item.kind === 'actividad' && (
                                <span class="text-[9px] font-extrabold bg-warning-soft text-warning-dark px-2 py-0.5 rounded-full uppercase tracking-wide shrink-0">
                                  Actividad
                                </span>
                              )}
                            </div>
                            <p class="text-xs text-subtle mt-0.5">
                              {item.meta}
                              {item.dueDate && (
                                <> · <span class="font-semibold text-heading">{item.dueDate}</span></>
                              )}
                            </p>
                          </div>

                          <!-- Acciones (Solo ver recurso) -->
                          <div class="shrink-0 flex items-center">
                            <a
                              href={APP_ROUTES.courseResource(course.id, item.id)}
                              class="bg-brand-soft text-brand-dark px-3 py-1.5 rounded-lg hover:bg-brand hover:text-white transition-colors text-xs font-bold"
                              title="Ver recurso"
                              aria-label={`Ver ${item.title}`}
                            >
                              Ver
                            </a>
                          </div>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- Columna Derecha: Estadísticas del Curso -->
        <aside class="flex flex-col gap-5">
          <!-- Stats del curso -->
          <section class="bg-card rounded-2xl border border-edge p-6" aria-labelledby="course-stats-heading">
            <h2 id="course-stats-heading" class="text-sm font-extrabold text-heading uppercase tracking-wider mb-5">
              Resumen del curso
            </h2>
            <ul class="flex flex-col gap-4">
              {[
                { icon: 'lucide:users',          label: 'Compañeros de clase',  value: String(course.studentCount) },
                { icon: 'lucide:layout-list',    label: 'Semanas de contenido', value: String(courseWeeks.length)   },
                { icon: 'lucide:trending-up',    label: 'Mi progreso',          value: `${course.averageProgress}%` },
              ].map((stat) => (
                <li class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-neutral-subtle flex items-center justify-center shrink-0">
                    <Icon name={stat.icon} class="w-4 h-4 text-subtle" aria-hidden="true" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs text-subtle font-medium">{stat.label}</p>
                    <p class="text-sm font-extrabold text-heading">{stat.value}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>

          <!-- Acciones rápidas -->
          <section class="bg-card rounded-2xl border border-edge p-6" aria-labelledby="quick-actions-heading">
            <h2 id="quick-actions-heading" class="text-sm font-extrabold text-heading uppercase tracking-wider mb-4">
              Atajos
            </h2>
            <ul class="flex flex-col gap-2">
              {[
                { icon: 'lucide:users',      label: 'Ver compañeros', href: APP_ROUTES.courseStudents(course.id) },
                { icon: 'lucide:megaphone',  label: 'Ver anuncios',  href: APP_ROUTES.courseAnnouncements(course.id) },
                { icon: 'lucide:star',       label: 'Mis calificaciones', href: APP_ROUTES.grades },
              ].map((action) => (
                <li>
                  <a
                    href={action.href}
                    class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-subtle hover:bg-brand-soft/40 hover:text-brand-dark transition-colors"
                  >
                    <Icon name={action.icon} class="w-4 h-4 flex-shrink-0" aria-hidden="true" />
                    {action.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>

        </aside>
      </div>
    </div>
  </div>

<script>
  // ── Accordion de semanas ──────────────────────────────────────
  // El chevron se rota con CSS (transform) porque el SVG ya está
  // renderizado en el servidor y no se puede cambiar el 'name' dinámicamente.
  document.querySelectorAll('.week-toggle').forEach((header) => {
    header.addEventListener('click', () => {
      const article = header.closest('article');
      if (!article) return;

      const itemsPanel = article.querySelector('.week-items') as HTMLElement | null;
      const chevron    = article.querySelector('.week-chevron') as HTMLElement | null;
      if (!itemsPanel) return;

      const isNowHidden = itemsPanel.classList.toggle('hidden');

      if (chevron) {
        // Rotar 180° cuando está expandido, 0° cuando está colapsado
        chevron.style.transform = isNowHidden ? 'rotate(0deg)' : 'rotate(180deg)';
      }
    });
  });
</script>

</DashboardLayout>
