---
/**
 * profesor/biblioteca.astro — Biblioteca de Recursos del Profesor
 * ─────────────────────────────────────────────────────────────────
 * Gestión centralizada de todos los recursos del docente:
 * documentos, videos, presentaciones, audio y enlaces.
 * Incluye buscador, filtros por tipo y curso, y carga de nuevos recursos.
 */
import TeacherDashboardLayout from '../../layouts/TeacherDashboardLayout.astro';
import { Icon } from 'astro-icon/components';
import { getLibraryResources } from '../../core/services/library.service';
import type { LibraryResource } from '../../types/api.types';

const token = Astro.cookies.get('ka_session')?.value;
if (!token) return Astro.redirect('/login');

let resources: LibraryResource[] = [];
try {
  const res = await getLibraryResources(token, 1, 100);
  resources = res.resources || [];
} catch (e) {
  console.error("Error fetching library:", e);
}

const typeConfig = {
  documento:    { label: 'Documento',     icon: 'lucide:file-text',      bg: 'bg-blue-50',    icon_color: 'text-blue-600'   },
  video:        { label: 'Video',         icon: 'lucide:video',          bg: 'bg-purple-50',  icon_color: 'text-purple-600' },
  presentacion: { label: 'Presentación',  icon: 'lucide:presentation',   bg: 'bg-orange-50',  icon_color: 'text-orange-500' },
  audio:        { label: 'Audio',         icon: 'lucide:mic',            bg: 'bg-pink-50',    icon_color: 'text-pink-500'   },
  enlace:       { label: 'Enlace',        icon: 'lucide:external-link',  bg: 'bg-success-soft',   icon_color: 'text-success-dark'  },
  imagen:       { label: 'Imagen',        icon: 'lucide:image',          bg: 'bg-teal-50',    icon_color: 'text-teal-600'   },
} as const;

const totalBytes = resources.reduce((acc, r) => acc + (Number(r.fileSizeBytes) || 0), 0);
const mb = (totalBytes / (1024 * 1024)).toFixed(2);
const totalSize   = mb === '0.00' ? '0 MB' : `${mb} MB`;
const totalItems  = resources.length;
const publishedItems = resources.filter(r => r.isPublished).length;
---

<TeacherDashboardLayout
  pageTitle="Biblioteca Docente"
  breadcrumb="Biblioteca"
  activeNav="biblioteca"
>

  <div class="max-w-7xl mx-auto flex flex-col gap-8">

    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-heading">Biblioteca</h1>
        <p class="text-subtle font-medium mt-1 text-sm">Todos tus recursos en un solo lugar, reutilizables en cualquier curso.</p>
      </div>
      <button
        type="button"
        id="open-upload-resource-btn"
        class="flex items-center gap-2 bg-brand text-white font-bold text-sm px-5 py-3 rounded-xl hover:bg-brand-dark transition-colors shadow-sm w-full sm:w-auto justify-center"
      >
        <Icon name="lucide:upload-cloud" class="w-4 h-4" aria-hidden="true" />
        Subir Recurso
      </button>
    </div>

    <!-- Métricas rápidas -->
    <div class="grid grid-cols-3 gap-4">
      {[
        { icon: 'lucide:library',      label: 'Total recursos',  value: String(totalItems) },
        { icon: 'lucide:globe',         label: 'Publicados',      value: String(publishedItems) },
        { icon: 'lucide:hard-drive',    label: 'Almacenamiento',  value: totalSize },
      ].map((metric) => (
        <article class="bg-brand-soft/40 rounded-2xl p-5 flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-brand-soft flex items-center justify-center shrink-0">
            <Icon name={metric.icon} class="w-5 h-5 text-brand-dark" aria-hidden="true" />
          </div>
          <div>
            <p class="text-2xl font-extrabold text-heading">{metric.value}</p>
            <p class="text-xs text-subtle font-semibold">{metric.label}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Filtros y búsqueda -->
    <div class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <Icon name="lucide:search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted" aria-hidden="true" />
        <input
          type="search"
          id="library-search"
          placeholder="Buscar recurso por nombre o descripción..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-edge bg-card text-sm text-heading placeholder:text-muted font-medium focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent"
          aria-label="Buscar recurso"
        />
      </div>
      <!-- Filtro por tipo -->
      <select
        id="type-filter"
        class="px-4 py-2.5 rounded-xl border border-edge bg-card text-sm text-heading font-medium focus:outline-none focus:ring-2 focus:ring-brand appearance-none"
        aria-label="Filtrar por tipo"
      >
        <option value="">Todos los tipos</option>
        <option value="documento">Documentos</option>
        <option value="video">Videos</option>
        <option value="presentacion">Presentaciones</option>
        <option value="audio">Audio</option>
        <option value="enlace">Enlaces</option>
        <option value="imagen">Imágenes</option>
      </select>
      <!-- Filtro por curso -->
      <select
        id="course-filter"
        class="px-4 py-2.5 rounded-xl border border-edge bg-card text-sm text-heading font-medium focus:outline-none focus:ring-2 focus:ring-brand appearance-none"
        aria-label="Filtrar por curso"
      >
        <option value="">Todos los cursos</option>
        <option value="Inglés B2">Inglés B2</option>
        <option value="Business Eng">Business English</option>
        <option value="Inglés A1">Inglés A1</option>
        <option value="Todos">Todos los cursos</option>
      </select>
    </div>

    <!-- Tipo tabs de vista -->
    <div class="flex items-center gap-3">
      {['Todos', 'Publicados', 'Borradores'].map((tab, idx) => (
        <button
          type="button"
          class={`library-status-tab px-4 py-2 rounded-xl text-sm font-semibold border transition-colors ${idx === 0 ? 'bg-brand text-white border-brand' : 'bg-card text-subtle border-edge hover:border-brand/30 hover:text-heading'}`}
          data-tab={tab.toLowerCase()}
        >
          {tab}
        </button>
      ))}
    </div>

    <!-- Grid de recursos -->
    <section aria-labelledby="library-grid-heading">
      <h2 id="library-grid-heading" class="sr-only">Lista de recursos</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" id="library-grid">
        {resources.map((res) => {
          const cfg = typeConfig[res.type];
          return (
            <article
              class="bg-card rounded-2xl border border-edge hover:shadow-md transition-all group flex flex-col library-card relative"
              data-id={res.id}
              data-url={res.fileUrl || ''}
              data-title={res.title}
              data-description={res.description || ''}
              data-type={res.type || res.fileType || ''}
              data-course={res.courseTag || res.courseId || 'Todos'}
              data-published={res.isPublished ? 'true' : 'false'}
            >
              <!-- Card top -->
              <div class="p-5 flex items-start gap-4 flex-1">
                <div class={`w-12 h-12 rounded-xl ${cfg?.bg || 'bg-neutral-subtle'} flex items-center justify-center flex-shrink-0`}>
                  <Icon name={cfg?.icon || 'lucide:file'} class={`w-6 h-6 ${cfg?.icon_color || 'text-subtle'}`} aria-hidden="true" />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2 mb-1">
                    <h3 class="text-sm font-bold text-heading leading-snug group-hover:text-brand-dark transition-colors line-clamp-2">{res.title}</h3>
                    <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full flex-shrink-0 ${(res.isPublished) ? 'bg-success-soft text-success-dark' : 'bg-neutral-subtle text-subtle'}`}>
                      {(res.isPublished) ? 'Publicado' : 'Borrador / Oculto'}
                    </span>
                  </div>
                  <p class="text-xs text-subtle font-medium line-clamp-2 leading-relaxed">{res.description}</p>
                </div>
              </div>

              <!-- Metadata strip -->
              <div class="px-5 pb-4">
                <div class="flex items-center gap-3 flex-wrap text-[11px] text-muted font-semibold mb-4">
                  <span class={`flex items-center gap-1 ${cfg.icon_color} font-bold`}>
                    <Icon name={cfg.icon} class="w-3 h-3" aria-hidden="true" />
                    {cfg.label}
                  </span>
                  <span>·</span>
                  <span>{res.courseTag || 'Todos'}</span>
                  <span>·</span>
                  <span>{res.fileSizeBytes ? (Number(res.fileSizeBytes) / (1024*1024)).toFixed(2) + ' MB' : '—'}</span>
                  <span>·</span>
                  <span class="flex items-center gap-1">
                    <Icon name="lucide:users" class="w-3 h-3" aria-hidden="true" />
                    {res.usageCount}
                  </span>
                </div>
                <!-- Acciones -->
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-lg bg-neutral-subtle text-subtle text-xs font-bold hover:bg-brand-soft hover:text-brand-dark transition-colors btn-view-resource"
                    aria-label={`Descargar ${res.title}`}
                  >
                    <Icon name="lucide:download" class="w-3.5 h-3.5" aria-hidden="true" />
                    Descargar
                  </button>
                  <button
                    type="button"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-lg bg-neutral-subtle text-subtle text-xs font-bold hover:bg-brand-soft hover:text-brand-dark transition-colors btn-edit-resource"
                    aria-label={`Editar ${res.title}`}
                  >
                    <Icon name="lucide:pencil" class="w-3.5 h-3.5" aria-hidden="true" />
                    Editar
                  </button>
                  <div class="relative dropdown-container">
                    <button
                      type="button"
                      class="p-2 rounded-lg bg-neutral-subtle text-subtle text-xs font-bold hover:bg-brand-soft hover:text-brand-dark transition-colors btn-more-options"
                      aria-label={`Más opciones de ${res.title}`}
                    >
                      <Icon name="lucide:more-horizontal" class="w-3.5 h-3.5" aria-hidden="true" />
                    </button>
                    <!-- Dropdown Menú -->
                    <div class="absolute bottom-full right-0 mb-2 w-32 bg-white border border-edge shadow-lg rounded-xl flex-col hidden dropdown-menu z-10 overflow-hidden">
                      <button type="button" class="w-full text-left px-4 py-2.5 text-xs font-bold text-heading hover:bg-neutral-subtle transition-colors border-b border-edge flex items-center gap-2 btn-edit-resource">
                        <Icon name="lucide:pencil" class="w-3.5 h-3.5" /> Editar
                      </button>
                      <button type="button" class={`w-full text-left px-4 py-2.5 text-xs font-bold transition-colors flex items-center gap-2 btn-toggle-visibility hover:bg-neutral-subtle ${(res.isPublished) ? 'text-danger' : 'text-success'}`}>
                        <Icon name={(res.isPublished) ? 'lucide:eye-off' : 'lucide:eye'} class="w-3.5 h-3.5" /> 
                        {(res.isPublished) ? 'Ocultar' : 'Mostrar'}
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Estado vacío -->
      <div id="empty-state" class="hidden flex-col items-center justify-center gap-4 py-20 text-center">
        <div class="w-16 h-16 rounded-2xl bg-neutral-subtle flex items-center justify-center mx-auto">
          <Icon name="lucide:search-x" class="w-8 h-8 text-muted" aria-hidden="true" />
        </div>
        <div>
          <p class="font-bold text-heading">Sin resultados</p>
          <p class="text-sm text-subtle font-medium mt-1">Prueba con otro filtro o término de búsqueda.</p>
        </div>
      </div>
    </section>

  </div>

  <!-- ░░ MODAL: SUBIR RECURSO ░░ -->
  <div
    id="upload-resource-modal"
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="upload-resource-modal-title"
  >
    <div id="upload-resource-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm cursor-pointer"></div>
    <div
      id="upload-resource-panel"
      class="relative bg-card w-full sm:w-[90%] sm:max-w-xl max-h-[90vh] rounded-t-3xl sm:rounded-3xl shadow-2xl flex flex-col overflow-hidden transform translate-y-4 sm:scale-95 transition-transform duration-300 border border-edge"
    >
      <!-- Header -->
      <div class="px-6 py-5 border-b border-edge-soft flex items-center justify-between bg-neutral-bg/30 shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-brand-soft flex items-center justify-center shrink-0">
            <Icon name="lucide:upload-cloud" class="w-5 h-5 text-brand-dark" aria-hidden="true" />
          </div>
          <h2 id="upload-resource-modal-title" class="text-lg font-extrabold text-heading">Subir Recurso</h2>
        </div>
        <button id="close-upload-resource-btn" type="button" class="p-2 rounded-full hover:bg-neutral-subtle text-subtle hover:text-heading transition-colors" aria-label="Cerrar">
          <Icon name="lucide:x" class="w-5 h-5" aria-hidden="true" />
        </button>
      </div>

      <!-- Body -->
      <div class="p-6 overflow-y-auto flex-1">
        <form id="upload-resource-form" class="flex flex-col gap-5" novalidate>
          <input type="hidden" id="library-resource-id" name="libraryResourceId" value="" />

          <!-- Drop zone -->
          <label
            for="library-file-input"
            id="library-dropzone"
            class="flex flex-col items-center gap-3 p-8 rounded-2xl border-2 border-dashed border-edge hover:border-brand/40 hover:bg-brand-soft/10 cursor-pointer transition-all text-center"
          >
            <div class="w-14 h-14 rounded-2xl bg-brand-soft flex items-center justify-center">
              <Icon name="lucide:upload-cloud" class="w-7 h-7 text-brand-dark" aria-hidden="true" />
            </div>
            <div>
              <p class="text-sm font-bold text-heading">Arrastra tu archivo aquí</p>
              <p class="text-xs text-subtle font-medium mt-1">o haz clic para seleccionarlo</p>
              <p id="library-file-name" class="text-xs font-semibold text-brand-dark mt-2 hidden"></p>
            </div>
            <input type="file" id="library-file-input" name="libraryFile" class="sr-only" accept=".pdf,.doc,.docx,.ppt,.pptx,.mp4,.mp3,.wav,.png,.jpg,.jpeg,.gif,.webp" />
            <p class="text-[11px] text-muted font-medium">PDF, Word, PPT, MP4, MP3, PNG, JPG · Máx. 100 MB</p>
          </label>

          <!-- Tipo de enlace -->
          <div class="flex items-center gap-3">
            <div class="flex-1 border-t border-edge-soft"></div>
            <span class="text-xs text-muted font-semibold">o agregar enlace externo</span>
            <div class="flex-1 border-t border-edge-soft"></div>
          </div>
          <div class="relative">
            <Icon name="lucide:link" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none" aria-hidden="true" />
            <input
              type="url"
              id="library-external-url"
              name="libraryUrl"
              placeholder="https://view.genial.ly/..."
              class="w-full pl-10 pr-4 py-3 rounded-xl border border-edge bg-neutral-bg/30 text-sm text-heading font-medium placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition"
            />
          </div>

          <!-- Nombre del recurso -->
          <div class="flex flex-col gap-1.5">
            <label for="library-resource-title" class="text-xs font-bold text-heading uppercase tracking-wider">
              Nombre del recurso <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="library-resource-title"
              name="libraryResourceTitle"
              placeholder="Ej: Guía de pronunciación B2"
              required
              class="w-full px-4 py-3 rounded-xl border border-edge bg-neutral-bg/30 text-sm text-heading font-medium placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition"
            />
          </div>

          <!-- Tipo + Curso en grid -->
          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="library-resource-type" class="text-xs font-bold text-heading uppercase tracking-wider">Tipo</label>
              <select id="library-resource-type" name="libraryResourceType" class="w-full px-4 py-3 rounded-xl border border-edge bg-neutral-bg/30 text-sm text-heading font-medium focus:outline-none focus:ring-2 focus:ring-brand appearance-none">
                <option value="documento">Documento</option>
                <option value="video">Video</option>
                <option value="presentacion">Presentación</option>
                <option value="audio">Audio</option>
                <option value="enlace">Enlace</option>
                <option value="imagen">Imagen</option>
              </select>
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="library-resource-course" class="text-xs font-bold text-heading uppercase tracking-wider">Curso</label>
              <select id="library-resource-course" name="libraryResourceCourse" class="w-full px-4 py-3 rounded-xl border border-edge bg-neutral-bg/30 text-sm text-heading font-medium focus:outline-none focus:ring-2 focus:ring-brand appearance-none">
                <option value="Todos">Todos</option>
                <option value="Inglés B2">Inglés B2</option>
                <option value="Business Eng">Business English</option>
                <option value="Inglés A1">Inglés A1</option>
              </select>
            </div>
          </div>

        </form>
      </div>

      <!-- Footer -->
      <div class="px-6 py-4 border-t border-edge-soft flex items-center justify-end gap-3 bg-neutral-bg/20 shrink-0">
        <button type="button" id="cancel-upload-resource-btn" class="px-5 py-2.5 rounded-xl border border-edge text-sm font-bold text-subtle hover:bg-neutral-subtle transition-colors">
          Cancelar
        </button>
        <button type="submit" form="upload-resource-form" class="flex items-center gap-2 px-6 py-2.5 rounded-xl bg-brand text-white text-sm font-bold hover:bg-brand-dark transition-colors shadow-sm">
          <Icon name="lucide:upload-cloud" class="w-4 h-4" aria-hidden="true" />
          Subir a Biblioteca
        </button>
      </div>
    </div>
  </div>

</TeacherDashboardLayout>

<script>
  // Auth manejada por middleware server-side (src/middleware.ts).

  // ── Modal subir recurso ────────────────────────────────────────
  const uploadModal    = document.getElementById('upload-resource-modal');
  const uploadBackdrop = document.getElementById('upload-resource-backdrop');
  const uploadPanel    = document.getElementById('upload-resource-panel');
  const closeBtn       = document.getElementById('close-upload-resource-btn');
  const cancelBtn      = document.getElementById('cancel-upload-resource-btn');

  const openModal = () => {
    if (!uploadModal || !uploadPanel) return;
    uploadModal.classList.remove('opacity-0', 'pointer-events-none');
    uploadPanel.classList.remove('translate-y-4', 'sm:scale-95');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    if (!uploadModal || !uploadPanel) return;
    uploadModal.classList.add('opacity-0', 'pointer-events-none');
    uploadPanel.classList.add('translate-y-4', 'sm:scale-95');
    document.body.style.overflow = '';
    
    // Resetear formulario
    setTimeout(() => {
      const form = document.getElementById('upload-resource-form') as HTMLFormElement;
      if (form) form.reset();
      const title = document.getElementById('upload-resource-modal-title');
      const submitBtn = document.querySelector('button[form="upload-resource-form"]') as HTMLElement;
      if (title) title.textContent = 'Subir Recurso';
      if (submitBtn) submitBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16v-9"/><path d="m16 11-4-4-4 4"/><path d="M8 21h8a4 4 0 0 0 4-4v-1a4 4 0 0 0-4-4h-1a3 3 0 0 0-6 0H8a4 4 0 0 0-4 4v1a4 4 0 0 0 4 4z"/></svg> Subir a Biblioteca';
      const idInput = document.getElementById('library-resource-id') as HTMLInputElement;
      if (idInput) idInput.value = '';
      const fileNameLabel = document.getElementById('library-file-name');
      if (fileNameLabel) fileNameLabel.classList.add('hidden');
    }, 300);
  };

  document.getElementById('open-upload-resource-btn')?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);
  uploadBackdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !uploadModal?.classList.contains('opacity-0')) closeModal();
  });

  // ── Drag & Drop + file input ──────────────────────────────────
  const fileInput      = document.getElementById('library-file-input') as HTMLInputElement;
  const fileNameLabel  = document.getElementById('library-file-name');
  const dropzone       = document.getElementById('library-dropzone');

  fileInput?.addEventListener('change', () => {
    const name = fileInput.files?.[0]?.name;
    if (name && fileNameLabel) {
      fileNameLabel.textContent = name;
      fileNameLabel.classList.remove('hidden');
    }
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-brand', 'bg-brand-soft/20');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-brand', 'bg-brand-soft/20');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-brand', 'bg-brand-soft/20');
    const files = (e as DragEvent).dataTransfer?.files;
    if (files?.[0] && fileInput && fileNameLabel) {
      // DataTransfer isn't directly assignable, just show the name
      fileNameLabel.textContent = files[0].name;
      fileNameLabel.classList.remove('hidden');
    }
  });

  // ── Filtros combinados ─────────────────────────────────────────
  const searchInput  = document.getElementById('library-search')  as HTMLInputElement;
  const typeFilter   = document.getElementById('type-filter')     as HTMLSelectElement;
  const courseFilter = document.getElementById('course-filter')   as HTMLSelectElement;
  const emptyState   = document.getElementById('empty-state');

  let activeTab = 'todos';

  const filterCards = () => {
    const query  = searchInput?.value.toLowerCase() ?? '';
    const type   = typeFilter?.value ?? '';
    const course = courseFilter?.value ?? '';
    const cards  = document.querySelectorAll('.library-card');
    let visible  = 0;

    cards.forEach((card) => {
      const cardText      = card.textContent?.toLowerCase() ?? '';
      const cardType      = card.getAttribute('data-type') ?? '';
      const cardCourse    = card.getAttribute('data-course') ?? '';
      const cardPublished = card.getAttribute('data-published') ?? 'true';

      const matchSearch  = cardText.includes(query);
      const matchType    = !type   || cardType === type;
      const matchCourse  = !course || cardCourse === course;
      const matchTab     = activeTab === 'todos'
        ? true
        : activeTab === 'publicados'
        ? cardPublished === 'true'
        : cardPublished === 'false'; // borradores

      const isVisible = matchSearch && matchType && matchCourse && matchTab;
      (card as HTMLElement).style.display = isVisible ? '' : 'none';
      if (isVisible) visible++;
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', visible > 0);
      emptyState.classList.toggle('flex', visible === 0);
    }
  };

  searchInput?.addEventListener('input', filterCards);
  typeFilter?.addEventListener('change', filterCards);
  courseFilter?.addEventListener('change', filterCards);

  document.querySelectorAll('.library-status-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeTab = btn.getAttribute('data-tab') ?? 'todos';
      document.querySelectorAll('.library-status-tab').forEach(b => {
        b.classList.remove('bg-brand', 'text-white', 'border-brand');
        b.classList.add('bg-card', 'text-subtle', 'border-edge');
      });
      btn.classList.add('bg-brand', 'text-white', 'border-brand');
      btn.classList.remove('bg-card', 'text-subtle', 'border-edge');
      filterCards();
    });
  });

  // ── Subida real a Cloudinary y API ───────────────────────────────────
  import { uploadFile } from '../../core/services/upload.service';
  import { createResource, updateResource, setResourcePublished } from '../../core/services/library.service';

  const form = document.getElementById('upload-resource-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.querySelector('button[form="upload-resource-form"]') as HTMLButtonElement;
    const titleEl = document.getElementById('library-resource-title') as HTMLInputElement;
    if (!titleEl.value.trim()) return;

    btn.disabled = true;
    const originalText = btn.innerHTML;
    btn.innerHTML = 'Subiendo...';

    try {
      let fileUrl = '';
      const fileInput = document.getElementById('library-file-input') as HTMLInputElement;
      const file = fileInput.files?.[0];
      const externalUrl = (document.getElementById('library-external-url') as HTMLInputElement).value;

      const tokenMatch = document.cookie.match(/(?:^|; )ka_session=([^;]*)/);
      const token = tokenMatch ? tokenMatch[1] : '';

      if (file) {
        const res = await uploadFile(file, 'library', token);
        fileUrl = res.url;
      } else if (externalUrl) {
        fileUrl = externalUrl;
      }

      const isEdit = !!(document.getElementById('library-resource-id') as HTMLInputElement).value;
      const resourceId = (document.getElementById('library-resource-id') as HTMLInputElement).value;

      const payload: any = {
        title: titleEl.value,
        type: (document.getElementById('library-resource-type') as HTMLSelectElement).value,
        courseTag: (document.getElementById('library-resource-course') as HTMLSelectElement).value,
      };

      if (fileUrl) {
        payload.fileUrl = fileUrl;
      }

      if (isEdit) {
        await updateResource(token, resourceId, payload);
        showBibToast('Recurso actualizado exitosamente', false);
      } else {
        await createResource(token, payload);
        showBibToast('Recurso subido exitosamente a la Biblioteca', false);
      }

      window.location.reload();
      form.reset();
      const fileNameLabel = document.getElementById('library-file-name');
      if (fileNameLabel) fileNameLabel.classList.add('hidden');
    } catch (err) {
      console.error(err);
      showBibToast('Error al subir el archivo. Verifica el límite de tamaño.', true);
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  function showBibToast(msg: string, isError: boolean = false) {
    const existing = document.getElementById('bib-toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.id = 'bib-toast';
    toast.className = `fixed bottom-6 right-6 z-[60] flex items-center gap-3 px-5 py-3.5 rounded-2xl shadow-2xl transition-all duration-500 ${isError ? 'bg-danger text-white' : 'bg-heading text-white'}`;
    toast.style.cssText = 'opacity:0; transform:translateY(20px)';
    const icon = isError
      ? '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
      : '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>';
    const iconBg = isError ? 'bg-white/20' : 'bg-success';
    toast.innerHTML = `<div class="w-7 h-7 rounded-full ${iconBg} flex items-center justify-center shrink-0">${icon}</div><p class="text-sm font-bold">${msg}</p>`;
    document.body.appendChild(toast);
    requestAnimationFrame(() => { toast.style.opacity = '1'; toast.style.transform = 'translateY(0)'; });
    setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateY(20px)'; setTimeout(() => toast.remove(), 500); }, 3500);
  }

  // ── Interacciones de los botones (Ver, Editar, Ocultar) ───────────────────
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Menú de 3 puntos (Ocultar/Cerrar clics fuera)
    const allDropdowns = document.querySelectorAll('.dropdown-menu');
    if (!target.closest('.dropdown-container')) {
      allDropdowns.forEach(d => d.classList.add('hidden'));
    }

    const moreBtn = target.closest('.btn-more-options');
    if (moreBtn) {
      const dropdown = moreBtn.nextElementSibling;
      if (dropdown) {
        const isHidden = dropdown.classList.contains('hidden');
        allDropdowns.forEach(d => d.classList.add('hidden'));
        if (isHidden) dropdown.classList.remove('hidden');
      }
      return;
    }

    // Botón Descargar (Anteriormente Ver)
    const viewBtn = target.closest('.btn-view-resource');
    if (viewBtn) {
      const article = viewBtn.closest('.library-card');
      const url = article?.getAttribute('data-url');
      if (url) {
        const downloadUrl = url.includes('res.cloudinary.com') ? url.replace('/upload/', '/upload/fl_attachment/') : url;
        window.open(downloadUrl, '_blank');
      } else {
        showBibToast('Este recurso no tiene un archivo adjunto.', true);
      }
      return;
    }

    // Botón Editar
    const editBtn = target.closest('.btn-edit-resource');
    if (editBtn) {
      const article = editBtn.closest('.library-card');
      if (!article) return;
      
      const id = article.getAttribute('data-id') || '';
      const title = article.getAttribute('data-title') || '';
      const type = article.getAttribute('data-type') || 'documento';
      const course = article.getAttribute('data-course') || 'Todos';
      const url = article.getAttribute('data-url') || '';

      const idInput = document.getElementById('library-resource-id') as HTMLInputElement;
      const titleInput = document.getElementById('library-resource-title') as HTMLInputElement;
      const typeInput = document.getElementById('library-resource-type') as HTMLSelectElement;
      const courseInput = document.getElementById('library-resource-course') as HTMLSelectElement;
      const modalTitle = document.getElementById('upload-resource-modal-title');
      const submitBtn = document.querySelector('button[form="upload-resource-form"]') as HTMLElement;
      
      if (idInput) idInput.value = id;
      if (titleInput) titleInput.value = title;
      if (typeInput) typeInput.value = type;
      if (courseInput) courseInput.value = course;

      if (url && type === 'enlace') {
        const urlInput = document.getElementById('library-external-url') as HTMLInputElement;
        if (urlInput) urlInput.value = url;
      }

      if (modalTitle) modalTitle.textContent = 'Editar Recurso';
      if (submitBtn) submitBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16v-9"/><path d="m16 11-4-4-4 4"/><path d="M8 21h8a4 4 0 0 0 4-4v-1a4 4 0 0 0-4-4h-1a3 3 0 0 0-6 0H8a4 4 0 0 0-4 4v1a4 4 0 0 0 4 4z"/></svg> Actualizar Recurso';

      allDropdowns.forEach(d => d.classList.add('hidden'));
      openModal();
      return;
    }

    // Botón Ocultar/Mostrar
    const toggleVisibilityBtn = target.closest('.btn-toggle-visibility');
    if (toggleVisibilityBtn) {
      const article = toggleVisibilityBtn.closest('.library-card');
      if (!article) return;

      const id = article.getAttribute('data-id');
      const isPublished = article.getAttribute('data-published') === 'true';
      if (!id) return;

      // Mostrar spinner en el botón mientras se procesa
      const originalHtml = toggleVisibilityBtn.innerHTML;
      toggleVisibilityBtn.disabled = true;
      toggleVisibilityBtn.innerHTML = '<svg class="animate-spin w-3.5 h-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/></svg> Guardando...';

      try {
        const tokenMatch = document.cookie.match(/(?:^|; )ka_session=([^;]*)/);
        const token = tokenMatch ? tokenMatch[1] : '';
        // Usar el endpoint dedicado PATCH /library/:id/publish con el campo correcto
        await setResourcePublished(token, id, !isPublished);
        showBibToast(`Recurso ${isPublished ? 'ocultado' : 'publicado'} exitosamente.`, false);
        window.location.reload();
      } catch (e) {
        console.error('Error al cambiar visibilidad:', e);
        toggleVisibilityBtn.innerHTML = originalHtml;
        toggleVisibilityBtn.disabled = false;
        showBibToast('Error al actualizar la visibilidad del recurso.', true);
      }
    }
  });
</script>
