---
import { cva } from 'class-variance-authority';

interface Props {
  variant?: 'default' | 'primary' | 'success' | 'warning' | 'danger' | 'muted';
  label: string;
}

const { variant = 'default', label } = Astro.props;

const badgeVariants = cva(
  'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium',
  {
    variants: {
      variant: {
        default: 'bg-neutral-subtle text-body',
        primary: 'bg-brand-soft text-brand',
        success: 'bg-success-soft text-success-dark',
        warning: 'bg-warning-soft text-amber-700',
        danger:  'bg-danger-soft text-danger-dark',
        muted:   'bg-neutral-bg text-muted border border-edge',
      },
    },
    defaultVariants: { variant: 'default' },
  }
);
---

<span class={badgeVariants({ variant })}>{label}</span>
