---
interface Props {
  value: number;
  showLabel?: boolean;
  colorClass?: string;
}

const { value, showLabel = false, colorClass = 'bg-brand' } = Astro.props;
const clampedValue = Math.min(100, Math.max(0, value));
---

<div class="flex items-center gap-2">
  <div
    role="progressbar"
    aria-valuenow={clampedValue}
    aria-valuemin={0}
    aria-valuemax={100}
    aria-label={`Progreso: ${clampedValue}%`}
    class="flex-1 h-1.5 bg-neutral-light rounded-full overflow-hidden"
  >
    <div
      class={`h-full rounded-full transition-all duration-500 ${colorClass}`}
      style={`width: ${clampedValue}%`}
    ></div>
  </div>
  {showLabel && (
    <span class="text-xs font-semibold text-brand w-8 text-right flex-shrink-0">
      {clampedValue}%
    </span>
  )}
</div>
