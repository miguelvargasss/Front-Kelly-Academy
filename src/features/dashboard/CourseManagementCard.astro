---
import Badge from '../../components/ui/Badge.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  courseTitle: string;
  schedule: string;
  levelLabel: string;
  studentCount: number;
  courseHref: string;
}

const { courseTitle, schedule, levelLabel, studentCount, courseHref } = Astro.props;
---

<article class="bg-card rounded-xl border border-edge p-5 flex flex-col gap-3 hover:shadow-md transition-shadow duration-200">
  <div class="flex items-start justify-between gap-2">
    <Badge label={levelLabel} variant="default" />
    <button type="button" aria-label={`Más opciones para ${courseTitle}`}
      class="p-1 text-muted hover:text-heading transition-colors rounded-md hover:bg-neutral-subtle">
      <Icon name="lucide:more-vertical" class="w-4 h-4" />
    </button>
  </div>

  <div>
    <h3 class="text-base font-bold text-heading leading-snug">{courseTitle}</h3>
    <p class="text-sm text-subtle mt-0.5">{schedule}</p>
  </div>

  <div class="flex items-center justify-between pt-1 border-t border-edge-soft">
    <div class="flex items-center gap-1.5 text-sm text-subtle">
      <Icon name="lucide:users" class="w-4 h-4" aria-hidden="true" />
      <span>{studentCount} alumnos</span>
    </div>
    <a href={courseHref} class="flex items-center gap-1 text-sm font-semibold text-brand hover:underline">
      Ver detalles
      <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" aria-hidden="true" />
    </a>
  </div>
</article>
