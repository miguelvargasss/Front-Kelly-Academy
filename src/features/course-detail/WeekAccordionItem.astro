---
import { Icon } from 'astro-icon/components';

type ContentItemType = 'class' | 'task' | 'reading';

interface WeekContentItem {
  type: ContentItemType;
  title: string;
  meta: string;
  badge?: string;
  badgeHref?: string;
}

interface Props {
  weekNumber: number;
  weekTitle: string;
  weekDescription?: string;
  isExpanded?: boolean;
  isCurrent?: boolean;
  completionPercent?: number;
  completionLabel?: string;
  contentItems?: WeekContentItem[];
  showAddContent?: boolean;
}

const {
  weekNumber, weekTitle, weekDescription,
  isExpanded = false, isCurrent = false,
  completionPercent, completionLabel,
  contentItems = [], showAddContent = false,
} = Astro.props;

const typeIconMap: Record<ContentItemType, string> = {
  class:   'lucide:video',
  task:    'lucide:file-edit',
  reading: 'lucide:book-open',
};
---

<article class={`rounded-xl border overflow-hidden ${isCurrent ? 'border-l-4 border-brand' : 'border-edge'}`}>

  <div class="flex items-start gap-4 p-4 bg-card">
    <div class={`flex-shrink-0 w-9 h-9 rounded-lg flex items-center justify-center text-sm font-bold ${isCurrent ? 'bg-brand text-white' : 'bg-neutral-subtle text-subtle'}`} aria-hidden="true">
      {weekNumber}
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-2">
        <div>
          <h3 class="text-sm font-bold text-heading">{weekTitle}</h3>
          {weekDescription && <p class="text-xs text-subtle mt-0.5">{weekDescription}</p>}
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          {isCurrent && (
            <span class="text-xs font-semibold text-brand bg-brand-soft px-2 py-0.5 rounded-full">ACTUAL</span>
          )}
          {completionLabel && !isCurrent && (
            <span class="text-xs text-subtle">{completionPercent}% {completionLabel}</span>
          )}
          <Icon name="lucide:more-vertical" class="w-4 h-4 text-muted" aria-hidden="true" />
        </div>
      </div>

      {completionPercent !== undefined && !isCurrent && (
        <div class="mt-2 flex items-center gap-2">
          <div class="flex-1 h-1 bg-neutral-subtle rounded-full overflow-hidden">
            <div class="h-full bg-brand rounded-full" style={`width: ${completionPercent}%`}
              role="progressbar" aria-valuenow={completionPercent} aria-valuemin={0} aria-valuemax={100}></div>
          </div>
          {completionLabel && <span class="text-xs text-subtle whitespace-nowrap">{completionLabel}</span>}
        </div>
      )}
    </div>
  </div>

  {isExpanded && contentItems.length > 0 && (
    <div class="border-t border-edge-soft bg-card">
      <ul class="divide-y divide-edge-soft">
        {contentItems.map((item) => (
          <li class="flex items-start gap-3 px-4 py-3">
            <div class="flex-shrink-0 w-7 h-7 bg-neutral-subtle rounded-md flex items-center justify-center mt-0.5">
              <Icon name={typeIconMap[item.type]} class="w-3.5 h-3.5 text-subtle" aria-hidden="true" />
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-heading">{item.title}</p>
              <p class="text-xs text-subtle mt-0.5">{item.meta}</p>
            </div>
            {item.badge && (
              <a href={item.badgeHref ?? '#'}
                class="flex-shrink-0 flex items-center gap-1 bg-brand-soft text-brand text-xs font-semibold px-2.5 py-1 rounded-full hover:bg-brand-muted transition-colors">
                <span class="w-1.5 h-1.5 rounded-full bg-brand" aria-hidden="true"></span>
                {item.badge}
                <Icon name="lucide:arrow-right" class="w-3 h-3" aria-hidden="true" />
              </a>
            )}
          </li>
        ))}
      </ul>

      {showAddContent && (
        <div class="px-4 py-3 border-t border-edge-soft">
          <button type="button" class="flex items-center gap-2 text-sm text-brand font-semibold hover:underline">
            <Icon name="lucide:circle-plus" class="w-4 h-4" aria-hidden="true" />
            Añadir contenido a Semana {weekNumber}
          </button>
        </div>
      )}
    </div>
  )}
</article>
