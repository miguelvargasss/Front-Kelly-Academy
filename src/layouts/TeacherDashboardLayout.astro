---
/**
 * TeacherDashboardLayout.astro
 * Layout base para TODAS las páginas del dashboard de profesores.
 * Encapsula: TeacherSidebar + Header + área de contenido principal.
 * Las páginas de profesor solo proveen el contenido via <slot />.
 */
import TeacherSidebar from '../components/ui/TeacherSidebar.astro';
import Header from '../components/ui/Header.astro';
import { ClientRouter } from 'astro:transitions';
import { authMe } from '../core/services/auth.service';
import '../styles/global.css';

interface Props {
  pageTitle: string;
  breadcrumb?: string;
  activeNav?: 'inicio' | 'cursos' | 'biblioteca' | 'alumnos' | 'configuracion';
  userName?: string;
  avatarSrc?: string;
}

const token = Astro.cookies.get('ka_session')?.value ?? '';
let fetchedUserName = 'Prof. Anderson';

try {
  if (token) {
    const userRes = await authMe(token);
    if (userRes) {
      const firstName = userRes.fullName ? userRes.fullName.split(' ')[0] : 'Anderson';
      fetchedUserName = `Prof. ${firstName}`;
    }
  } else {
    return Astro.redirect('/login');
  }
} catch (e: any) {
  console.error('Error fetching user in layout', e);
  // Si la petición falla (e.g. 401 Unauthorized), limpiar sesión y redirigir
  Astro.cookies.delete('ka_session', { path: '/' });
  Astro.cookies.delete('ka_role', { path: '/' });
  return Astro.redirect('/login');
}

const {
  pageTitle,
  breadcrumb = 'Portal Docente',
  activeNav = 'inicio',
  userName = fetchedUserName,
  avatarSrc = 'https://i.pinimg.com/736x/fb/f9/62/fbf962d2260047e6075b7a6cb38374e2.jpg',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle} — Kelly Academy | Docente</title>
    <meta name="description" content={`${pageTitle} | Portal Docente Kelly Academy`} />
    <ClientRouter />
  </head>
  <body class="flex h-screen overflow-hidden bg-page">

    <TeacherSidebar activeNav={activeNav} />

    <div class="flex flex-col flex-1 overflow-hidden">
      <Header
        breadcrumb={breadcrumb}
        userName={userName}
        userLevel="Docente Certificado"
        avatarSrc={avatarSrc}
      />
      <main class="flex-1 overflow-y-auto p-6 lg:p-8">
        <slot />
      </main>
    </div>

  </body>
</html>
