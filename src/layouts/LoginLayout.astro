---
/**
 * LoginLayout.astro
 * Layout limpio para la página de autenticación.
 * Sin sidebar ni header del dashboard. Sin etiquetas <style>.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  pageTitle?: string;
}

const { pageTitle = 'Iniciar Sesión' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle} — Miss Kelly Q. | Campus Virtual</title>
    <meta name="description" content="Accede a tu campus virtual Miss Kelly Q. Ingresa tus credenciales para acceder a tus lecciones y devocionales." />
    <!-- Dancing Script: para el texto cursivo del branding del panel izquierdo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class="m-0 p-0 min-h-screen bg-page font-sans antialiased">
    <slot />
  </body>
</html>
